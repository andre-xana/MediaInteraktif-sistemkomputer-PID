rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAssessment(data) {
      return data.keys().hasAll(['studentName', 'studentClass', 'totalScore', 'durationSeconds', 'submittedAt']) &&
             data.keys().hasOnly(['studentName', 'studentClass', 'totalScore', 'maxScore', 'durationSeconds', 'passed', 'correctCount', 'totalQuestions', 'submittedAt']) &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 128 &&
             data.studentClass is string && data.studentClass.size() >= 1 && data.studentClass.size() <= 64 &&
             data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 100 &&
             data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 7200 &&
             data.submittedAt is string && data.submittedAt.size() <= 64;
    }

    function isValidTeacherConfig(data) {
      return data.keys().hasAll(['teacherPin']) &&
             data.keys().hasOnly(['teacherPin', 'updatedAt']) &&
             data.teacherPin is string && data.teacherPin.size() >= 4 && data.teacherPin.size() <= 32;
    }

    match /assessments/{assessmentId} {
      // Allow reading so teacher dashboard can query student submissions
      allow read: if true;

      // Allow creating an assessment submission if payload is valid
      allow create: if isValidId(assessmentId) && isValidAssessment(incoming());

      // Submissions cannot be updated or modified to prevent tampering
      allow update: if false;

      // Allow deleting only with proper validation if needed
      allow delete: if isValidId(assessmentId);
    }

    match /settings/{settingId} {
      // Allow reading and writing teacher settings
      allow read: if isValidId(settingId);
      allow create, update: if isValidId(settingId) && isValidTeacherConfig(incoming());
      allow delete: if false;
    }
  }
}
